{
  "name": "@skrybe/cli",
  "version": "0.1.0",
  "description": "Command line interface for the Skrybe email marketing API",
  "type": "module",
  "bin": { "skrybe": "./dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
