{
  "name": "@skrybe/cli",
  "version": "0.1.0",
  "description": "Command line interface for the Skrybe email marketing API",
  "type": "module",
  "bin": {
    "skrybe": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "skrybe",
    "sendy",
    "email",
    "cli"
  ],
  "license": "UNLICENSED"
}
